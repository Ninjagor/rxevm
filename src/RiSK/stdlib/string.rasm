; Register Allocation:
    ; %19 - input mem address
    ; %20 - string length
    ; %21 - copy of mem address

; START strlen implementation
_STRLEN
    mov %21 %19
    mov %20 #0x0

_LOOP_STRL_1
    loadb %3 %21
    cmp %3 #0x0
    je  _STRL_RET
    add %20 %20 #0x1
    add %21 %21 #0x1
    jmp _LOOP_STRL_1

_STRL_RET
    ret
; END strlen implementation


; Register Allocation:
    ; %3 - iterator 1
    ; %4 - iterator 2 & tmp
    ; %19 - initial mem address of string
    ; %21 - mem address to copy string to
    ; %22 - initial+length
    ; %23 - loaded value from mem addr

; START strcpy implementation
_STRCPY
    ; swp tmp
    mov %4 %21

    call _STRLEN ; populates %20 with strlen

    ; get back
    mov %21 %4

    mov %3 %19
    mov %4 %21
    mov %22 %19
    add %22 %22 %20

_LOOP_STRCPY_1
    cmp %3 %22
    je  _STRCPY_RET

    loadb %23 %3
    store %4 %23

    add %3 %3 #0x1
    add %4 %4 #0x1

    jmp _LOOP_STRCPY_1

_STRCPY_RET
    ret
; END strcpy implementation
